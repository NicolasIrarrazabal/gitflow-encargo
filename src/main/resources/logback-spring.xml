<?xml version="1.0" encoding="UTF-8"?>
<!-- Logback (IE1). CONSOLE para texto plano y JSON_FILE para logs
     estructurados compatibles con CloudWatch Logs, Loki o ELK. -->
<configuration>

    <!-- Hereda la config por defecto de Spring Boot -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Consola, texto plano, para desarrollo local -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Archivo JSON con timestamp, nivel, logger, mensaje y MDC, para
         ingesta en CloudWatch Logs, Loki o Elasticsearch. -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/microservicio-auth.json</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/microservicio-auth.%d{yyyy-MM-dd}.json</fileNamePattern>
            <maxHistory>7</maxHistory>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>spanId</includeMdcKeyName>
            <customFields>{"service":"microservicio-auth"}</customFields>
        </encoder>
    </appender>

    <!-- Niveles por paquete -->
    <logger name="com.encargo.microservicio" level="INFO"/>
    <logger name="org.springframework" level="INFO"/>
    <logger name="io.micrometer" level="INFO"/>

    <!-- Root: manda a CONSOLE y JSON_FILE -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="JSON_FILE"/>
    </root>

</configuration>